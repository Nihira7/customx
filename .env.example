# ==============================================================================
# CustomsX Master Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Service Configuration (used by ai-service/.env)
# ------------------------------------------------------------------------------
# Your Groq API Key (required for tariff classification and defender analysis)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM model to use
GROQ_MODEL=openai/gpt-oss-20b


# ------------------------------------------------------------------------------
# 2. Frontend Configuration (used by frontend/.env.local)
# ------------------------------------------------------------------------------
# FastAPI Backend URL
NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8000

# Deployed CustomsEscrow contract address
NEXT_PUBLIC_CUSTOMS_CONTRACT_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707

# EVM Chain ID (31337 for local Anvil / Hardhat)
NEXT_PUBLIC_CHAIN_ID=31337

# RPC URL for MetaMask / Frontend JSON-RPC provider
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
