# CustomsX Frontend Environment Variables

# URL of the CustomsX AI FastAPI service
NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8000

# Deployed CustomsEscrow smart contract address on Anvil / local Ethereum node
NEXT_PUBLIC_CUSTOMS_CONTRACT_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707

# Local chain ID (Anvil default is 31337)
NEXT_PUBLIC_CHAIN_ID=31337

# RPC Endpoint for local Ethereum node / Anvil
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
